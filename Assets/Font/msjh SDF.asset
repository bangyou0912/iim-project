    characterSequence: "\u5275\u5EFA\u623F\u9593\u52A0\u5165\u623F\u9593\u4E09\u539F\u8272\u6D0B\u7D05\u85CD\u7DA0\u9752\u6731\u7D2B\u6A59\u9EC3\u9AB0\u5B50\u4E8C\u6B21\u4E09\u6B21\u904A\u6232\u958B\u59CB\u7D50\u675F\u56DE\u9996\u9801\u5BF6\u77F3\u62C6\u89E3\u7248\u57FA\u672C\u7248\u64F2\u9AB0\u5B50\u96E3\u5EA6\u8ACB\u627E\u51FA\u5C0D\u61C9\u7684\u5361\u5230\u73A9\u5BB6\u975B\u932F\u8AA4\u5931\u6557\u6210\u529F\u4F60\u6211\u4ED6\u4E00\u4E8C\u4E09\u56DB\u4E94\u516D\u4E03\u516B\u4E5D\u5341\u96F6\u9023\u7B49\u5F85\u6BCF\u540D\u73A9\u5BB6\u5404\u6709\u624B\u724C\u4E09\u539F\u8272\u8272\u5F69\u5361
      6 \u5F35\u3001\u4E8C\u6B21\u8272\u8272\u5F69\u5361 2 \u5F35\u3002\r\n\u724C\u5806\uFF1A\u6240\u6709\u4E09\u6B21\u8272\u8272\u5F69\u5361
      24 \u5F35\u3001\u767D\u8272\u8272\u5F69\u5361 2 \u5F35\u3001\u4E8C\u6B21\u8272\u8272\u5F69\u5361
      4 \u5F35\u3002\r\n\u4E09\u539F\u8272\u9AB0\u5B50 3 \u9846\u3002\r\n\u5BF6\u77F3\uFF1A\u904A\u6232\u8A08\u5206\u5DE5\u5177\u3002\r\n\u904A\u6232\u6B65\u9A5F\r\n\u5728\u904A\u6232\u684C\u9762\u4E0A\uFF0C\u7FFB\u958B
      4 \u5F35\u8272\u5F69\u5361\u4E26\u7F6E\u65BC\u683C\u5167\uFF0C\u5176\u9918\u8272\u5F69\u5361\u5247\u4FDD\u6301\u8986\u84CB\uFF0C\u653E\u7F6E\u65BC\u684C\u4E0A\u3002\r\n\u73A9\u5BB6\u8F2A\u6D41\u64F2\u9AB0\uFF0C\u53EF\u81EA\u7531\u9078\u64C7\u4F7F\u7528\u9AB0\u5B50\u7684\u984F\u8272\u548C\u624B\u4E2D\u7684\u8272\u5F69\u5361\u9032\u884C\u6DF7\u8272\uFF0C\u4EE5\u914D\u5C0D\u7FFB\u958B\u7684\u8272\u5F69\u5361\u3002\u82E5\u521D\u6B21\u64F2\u9AB0\u5F8C\u7121\u6CD5\u6210\u529F\u6DF7\u8272\uFF0C\u53EF\u9078\u64C7\u6D88\u8017
