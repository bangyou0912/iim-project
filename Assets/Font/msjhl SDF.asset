    characterSetSelectionMode: 7
    characterSequence: "\u4E09\u539F\u8272\u6D0B\u7D05\u85CD\u7DA0\u9752\u6731\u7D2B\u6A59\u9EC3\u9AB0\u5B50\u4E8C\u6B21\u4E09\u6B21\u904A\u6232\u958B\u59CB\u7D50\u675F\u56DE\u9996\u9801\u5BF6\u77F3\u62C6\u89E3\u7248\u57FA\u672C\u7248\u64F2\u9AB0\u5B50\u96E3\u5EA6\u8ACB\u627E\u51FA\u5C0D\u61C9\u7684\u5361\u5230\u73A9\u5BB6\u975B\u932F\u8AA4\u5931\u6557\u6210\u529F\u4F60\u6211\u4ED6\u4E00\u4E8C\u4E09\u56DB\u4E94\u516D\u4E03\u516B\u4E5D\u5341\u96F6\u9023\u7B49\u5F85\u6BCF\u540D\u73A9\u5BB6\u5404\u6709\u624B\u724C\u4E09\u539F\u8272\u8272\u5F69\u5361
